<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_paper_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="散页 · 随行印记"
        android:textColor="@color/ink_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="常居城市"
        android:textColor="@color/ink_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_motto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="生活自留地"
        android:textColor="@color/accent_warm"
        android:textSize="12sp"
        android:maxLines="2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@color/border_divider" />

    <TextView
        android:id="@+id/widget_today_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今日刻度: ¥ 0.00"
        android:textColor="@color/ink_muted"
        android:textSize="11sp" />

</LinearLayout>
