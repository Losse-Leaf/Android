<?xml version="1.0" encoding="utf-8"?>
<!--
  MOB-P2-71：自适应启动图标前景层。
  取自 public/favicon.svg 的核心意象：一张暖色相纸卡 + 深色影像窗 + 右下折角。
  画布 108×108dp，内容收在中央 72dp 安全区内（maskable 裁切不会切到主体）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 相纸卡片主体 -->
    <path
        android:pathData="M28,26 L80,26 L80,82 L28,82 Z"
        android:fillColor="#F4EEE2" />
    <path
        android:pathData="M28,26 L80,26 L80,30 L28,30 Z"
        android:fillColor="#E8DFCE" />

    <!-- 深色影像窗 -->
    <path
        android:pathData="M37,38 L71,38 L71,68 L37,68 Z"
        android:fillColor="#2A2724" />
    <path
        android:pathData="M40,41 L68,41 L68,52 L40,52 Z"
        android:fillColor="#5E6B57"
        android:fillAlpha="0.55" />

    <!-- 右下折角 -->
    <path
        android:pathData="M66,68 L80,68 L80,82 L66,82 Z"
        android:fillColor="#D9CFBC" />
</vector>
